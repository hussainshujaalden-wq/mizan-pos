generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Core ───────────────────────────────────────────

model Company {
  id         String    @id @default(uuid())
  name       String
  name_ar    String
  logo_url   String?
  tax_number String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  branches   Branch[]

  @@map("companies")
}

model Branch {
  id         String    @id @default(uuid())
  company_id String
  name       String
  name_ar    String
  address    String?
  phone      String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  company         Company         @relation(fields: [company_id], references: [id])
  users           User[]
  shifts          Shift[]
  products        Product[]
  sales           Sale[]
  purchases       Purchase[]
  stock_movements StockMovement[]
  stock_counts    StockCount[]
  customers       Customer[]
  suppliers       Supplier[]
  expenses        Expense[]
  cash_registers  CashRegister[]
  settings        Setting[]

  @@map("branches")
}

model Currency {
  id            String    @id @default(uuid())
  code          String
  name          String
  symbol        String
  exchange_rate Int
  is_default    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  sales           Sale[]
  sale_payments   SalePayment[]
  purchases       Purchase[]
  expenses        Expense[]
  cash_registers  CashRegister[]

  @@map("currencies")
}

model Setting {
  id         String    @id @default(uuid())
  branch_id  String?
  key        String
  value      String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  branch Branch? @relation(fields: [branch_id], references: [id])

  @@map("settings")
}

// ─── Auth ────────────────────────────────────────────

enum UserRole {
  admin
  manager
  cashier
  accountant
}

model User {
  id            String    @id @default(uuid())
  branch_id     String
  name          String
  username      String    @unique
  password_hash String
  role          UserRole
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  branch        Branch         @relation(fields: [branch_id], references: [id])  
  shifts        Shift[]
  sales         Sale[]
  purchases     Purchase[]
  expenses      Expense[]
  stock_counts  StockCount[]

  @@map("users")
}

model Shift {
  id              String    @id @default(uuid())
  branch_id       String
  user_id         String
  opened_at       DateTime
  closed_at       DateTime?
  opening_balance Int
  closing_balance Int?
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  branch Branch @relation(fields: [branch_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])
  sales  Sale[]

  @@map("shifts")
}

// ─── Products ────────────────────────────────────────

model Category {
  id         String    @id @default(uuid())
  name       String
  name_ar    String
  parent_id  String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  parent   Category?  @relation("CategoryParent", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@map("categories")
}

model Unit {
  id         String    @id @default(uuid())
  name       String
  name_ar    String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  products Product[]

  @@map("units")
}

model Brand {
  id         String    @id @default(uuid())
  name       String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  products Product[]

  @@map("brands")
}

model Product {
  id            String    @id @default(uuid())
  branch_id     String
  category_id   String?
  unit_id       String
  brand_id      String?
  name          String
  name_ar       String
  barcode       String?   @unique
  sku           String?
  cost_price    Int
  selling_price Int
  min_stock     Int       @default(0)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  branch          Branch          @relation(fields: [branch_id], references: [id])
  category        Category?       @relation(fields: [category_id], references: [id])
  unit            Unit            @relation(fields: [unit_id], references: [id])
  brand           Brand?          @relation(fields: [brand_id], references: [id])
  stock_movements StockMovement[]
  sale_items      SaleItem[]
  purchase_items  PurchaseItem[]
  stock_count_items StockCountItem[]

  @@map("products")
}

// ─── Inventory ───────────────────────────────────────

enum StockMovementType {
  purchase
  sale
  return_sale
  return_purchase
  adjustment
  transfer
}

model StockMovement {
  id             String            @id @default(uuid())
  branch_id      String
  product_id     String
  type           StockMovementType
  quantity       Int
  reference_id   String?
  reference_type String?
  notes          String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  deleted_at     DateTime?

  branch  Branch  @relation(fields: [branch_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("stock_movements")
}

model StockCount {
  id         String    @id @default(uuid())
  branch_id  String
  user_id    String
  counted_at DateTime
  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  branch Branch           @relation(fields: [branch_id], references: [id])
  user   User             @relation(fields: [user_id], references: [id])
  items  StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id             String    @id @default(uuid())
  stock_count_id String
  product_id     String
  expected_qty   Int
  actual_qty     Int
  difference     Int
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  stock_count StockCount @relation(fields: [stock_count_id], references: [id])
  product     Product    @relation(fields: [product_id], references: [id])

  @@map("stock_count_items")
}

// ─── Sales ───────────────────────────────────────────

model Customer {
  id         String    @id @default(uuid())
  branch_id  String
  name       String
  phone      String?
  balance    Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  branch Branch @relation(fields: [branch_id], references: [id])
  sales  Sale[]

  @@map("customers")
}

enum SaleStatus {
  draft
  completed
  returned
}

model Sale {
  id             String     @id @default(uuid())
  branch_id      String
  shift_id       String
  customer_id    String?
  user_id        String
  invoice_number String     @unique
  status         SaleStatus @default(draft)
  subtotal       Int
  discount_amount Int       @default(0)
  tax_amount     Int        @default(0)
  total          Int
  paid_amount    Int        @default(0)
  currency_id    String
  exchange_rate  Int
  notes          String?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  deleted_at     DateTime?

  branch   Branch    @relation(fields: [branch_id], references: [id])
  shift    Shift     @relation(fields: [shift_id], references: [id])
  customer Customer? @relation(fields: [customer_id], references: [id])
  user     User      @relation(fields: [user_id], references: [id])
  currency Currency  @relation(fields: [currency_id], references: [id])
  items    SaleItem[]
  payments SalePayment[]

  @@map("sales")
}

model SaleItem {
  id         String    @id @default(uuid())
  sale_id    String
  product_id String
  quantity   Int
  unit_price Int
  discount   Int       @default(0)
  total      Int
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  sale    Sale    @relation(fields: [sale_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("sale_items")
}

enum PaymentMethod {
  cash
  card
  transfer
  credit
}

model SalePayment {
  id            String        @id @default(uuid())
  sale_id       String
  method        PaymentMethod
  amount        Int
  currency_id   String
  exchange_rate Int
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?

  sale     Sale     @relation(fields: [sale_id], references: [id])
  currency Currency @relation(fields: [currency_id], references: [id])

  @@map("sale_payments")
}

// ─── Purchases ───────────────────────────────────────

model Supplier {
  id         String    @id @default(uuid())
  branch_id  String
  name       String
  phone      String?
  balance    Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  branch    Branch     @relation(fields: [branch_id], references: [id])
  purchases Purchase[]

  @@map("suppliers")
}

enum PurchaseStatus {
  draft
  completed
  returned
}

model Purchase {
  id              String         @id @default(uuid())
  branch_id       String
  supplier_id     String?
  user_id         String
  invoice_number  String?
  status          PurchaseStatus @default(draft)
  subtotal        Int
  discount_amount Int            @default(0)
  total           Int
  paid_amount     Int            @default(0)
  currency_id     String
  exchange_rate   Int
  notes           String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  deleted_at      DateTime?

  branch   Branch         @relation(fields: [branch_id], references: [id])
  supplier Supplier?      @relation(fields: [supplier_id], references: [id])
  user     User           @relation(fields: [user_id], references: [id])
  currency Currency       @relation(fields: [currency_id], references: [id])
  items    PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchase_id String
  product_id  String
  quantity    Int
  unit_price  Int
  total       Int
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  purchase Purchase @relation(fields: [purchase_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])

  @@map("purchase_items")
}

// ─── Finance ─────────────────────────────────────────

model CashRegister {
  id          String    @id @default(uuid())
  branch_id   String
  name        String
  balance     Int       @default(0)
  currency_id String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  branch   Branch   @relation(fields: [branch_id], references: [id])
  currency Currency @relation(fields: [currency_id], references: [id])

  @@map("cash_registers")
}

model Expense {
  id           String    @id @default(uuid())
  branch_id    String
  user_id      String
  category     String
  amount       Int
  currency_id  String
  exchange_rate Int
  description  String?
  expense_date DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  branch   Branch   @relation(fields: [branch_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])
  currency Currency @relation(fields: [currency_id], references: [id])

  @@map("expenses")
}